<Window x:Class="ManualBackup.App.RestoreConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="復元先への上書きを確認" Width="900" Height="480" MinWidth="680" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="各行の復元元から復元先へ、順番に復元します。同名ファイルは上書きされます。" TextWrapping="Wrap"/>
    <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,12" FontWeight="SemiBold"/>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" AutomationProperties.Name="復元の対応を確認">
      <DataGrid.Columns>
        <DataGridTextColumn Header="組" Binding="{Binding Number}" Width="40"/>
        <DataGridTextColumn Header="復元元" Binding="{Binding SourcePath}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        <DataGridTextColumn Header="復元先" Binding="{Binding DestinationPath}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        <DataGridTextColumn Header="追加" Binding="{Binding Added}" Width="60"/>
        <DataGridTextColumn Header="上書き" Binding="{Binding Updated}" Width="60"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" x:Name="RestoreConfirmButton" Content="復元を実行" Click="Confirm_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
      <Button DockPanel.Dock="Right" Content="キャンセル" IsCancel="True" IsDefault="True"/>
      <TextBlock Text="復元先だけにあるファイルは残します。" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
