<Window x:Class="ManualBackup.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Backup Desk — バックアップと復元" Width="1160" Height="1000" MinWidth="980" MinHeight="900" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="FolderColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="ToolTip" Value="見出しの境界を左右にドラッグして列幅を変更できます。"/>
    </Style>
    <Style x:Key="FolderGridEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FolderListResizeHandle" TargetType="Thumb">
      <Setter Property="Height" Value="12"/>
      <Setter Property="Cursor" Value="SizeNS"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
      <Setter Property="ToolTip" Value="上下にドラッグして一覧の高さを変更。ダブルクリックまたはHomeキーで標準の高さに戻します。"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Border x:Name="HandleSurface" Background="Transparent" CornerRadius="3">
          <Border x:Name="HandleGrip" Width="48" Height="3" Background="#94A3B8" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HandleSurface" Property="Background" Value="#F1F5F9"/><Setter TargetName="HandleGrip" Property="Background" Value="#0F766E"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HandleSurface" Property="Background" Value="#E2E8F0"/><Setter TargetName="HandleGrip" Property="Background" Value="#0F766E"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="HandleGrip" Property="Background" Value="#0F766E"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#142B35">
      <Grid Margin="20,28,20,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="BACKUP DESK" Foreground="White" FontSize="21" FontWeight="Bold" Margin="0,0,0,34"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="＋ 追加" Click="AddProfile_Click" IsEnabled="{Binding CanEdit}" Padding="8,5" Background="#25444F" Foreground="White" BorderThickness="0" FontSize="12" AutomationProperties.Name="バックアップ設定を追加"/>
          <TextBlock Text="フォルダー設定" Foreground="#C2D5D9" VerticalAlignment="Center" FontSize="12"/>
        </DockPanel>
        <ListBox Grid.Row="2" x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ProfileList_SelectionChanged">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,13"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#28525D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#5B8A94"/><Setter TargetName="Tile" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding LastRun, StringFormat='バックアップ: {0}'}" Foreground="#BDD2D7" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding RestoreLastRun, StringFormat='復元: {0}'}" Foreground="#BDD2D7" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3">
          <Border Height="1" Background="#34515A" Margin="0,16"/>
          <TextBlock Text="手動実行 / スケジュールなし" Foreground="#C2D5D9" FontSize="11"/>
          <TextBlock Text="設定はこのPCに自動保存されます。" Foreground="#85A6B0" FontSize="11" Margin="0,7,0,15"/>
          <Button Content="この設定を削除" Click="DeleteProfile_Click" IsEnabled="{Binding CanEdit}" Background="Transparent" Foreground="#C2D5D9" BorderBrush="#45616B" Padding="10,8" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="MainLayout" Grid.Column="1" Margin="30,18,30,14" LayoutUpdated="MainLayout_LayoutUpdated">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Content="使い方" Click="Help_Click" Padding="14,8" VerticalAlignment="Top"/>
        <StackPanel>
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEdit}" Margin="0,0,0,6">
            <RadioButton Content="バックアップ" GroupName="OperationMode" IsChecked="{Binding IsBackup}" FontSize="14" Padding="5,1" Margin="0,0,22,0" AutomationProperties.Name="バックアップモード"/>
            <RadioButton Content="復元" GroupName="OperationMode" IsChecked="{Binding IsRestore}" FontSize="14" Padding="5,1" AutomationProperties.Name="復元モード"/>
          </StackPanel>
          <TextBlock Text="{Binding ModeTitle}" FontSize="26" FontWeight="Bold"/>
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,8">
        <Grid IsEnabled="{Binding CanEdit}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="設定名" VerticalAlignment="Center"/>
          <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="設定名" Padding="11,6" Margin="0,0,0,4" MaxLength="80"/>
          <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,10" Visibility="{Binding BackupSourcesVisibility}">
            <StackPanel Visibility="{Binding BackupSourcesVisibility}">
              <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="同時実行数" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                  <ComboBox x:Name="ParallelSourcesComboBox" ItemsSource="{Binding ParallelSourceChoices}" SelectedItem="{Binding SelectedProfile.MaxParallelSources, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="58" Padding="7,4" VerticalContentAlignment="Center" AutomationProperties.Name="同時実行数" ToolTip="コピー元フォルダーを同時に処理する数（1～8）。1は順次実行です。1フォルダー内は順次コピーします。"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Content="フォルダー追加…" Click="AddSourceFolders_Click" Padding="10,6" Margin="0,0,6,0" ToolTip="複数フォルダーをまとめて選択できます"/>
                  <Button Content="パスを入力" Click="AddSourceRow_Click" Padding="10,6" Margin="0,0,6,0"/>
                  <Button Content="一覧から削除" Click="RemoveSource_Click" IsEnabled="{Binding CanRemoveSource}" Padding="10,6" ToolTip="選択したコピー元の登録を外します。ファイルは削除しません。"/>
                </StackPanel>
              </DockPanel>
              <DataGrid x:Name="SourceFoldersGrid" ItemsSource="{Binding SelectedProfile.SourceFolders}" SelectedItem="{Binding SelectedSourceEntry}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="True" ColumnHeaderStyle="{StaticResource FolderColumnHeader}" MinColumnWidth="140" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="36" Height="224" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.HorizontalScrollBarVisibility="Auto" CellEditEnding="SourceFoldersGrid_CellEditEnding" AutomationProperties.Name="コピー元フォルダー一覧">
                <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,3"/></Style></DataGrid.CellStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="コピー元フォルダー" Width="*" MinWidth="180" Binding="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource FolderGridEditor}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding SourcePath}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                  <DataGridTextColumn Header="保存先フォルダー名" Width="180" Binding="{Binding TargetFolderName, UpdateSourceTrigger=PropertyChanged}" EditingElementStyle="{StaticResource FolderGridEditor}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding TargetFolderName}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
              <Thumb x:Name="BackupFoldersResizeThumb" Style="{StaticResource FolderListResizeHandle}" AutomationProperties.Name="コピー元一覧の高さを変更" DragDelta="FolderListResize_DragDelta" PreviewKeyDown="FolderListResize_PreviewKeyDown" MouseDoubleClick="FolderListResize_MouseDoubleClick"/>
              <TextBlock Text="{Binding BackupLayoutHint}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupLayoutHint}"/>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding RestoreSourceVisibility}" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Button Content="組を追加" Click="AddRestoreRow_Click" Padding="10,6" Margin="0,0,6,0"/>
              <Button Content="バックアップ設定から追加" Click="ImportRestoreRows_Click" Padding="10,6" Margin="0,0,6,0" ToolTip="現在のバックアップ設定の保存先を復元元、コピー元を復元先として追加します。"/>
              <Button Content="一覧から削除" Click="RemoveRestoreRow_Click" IsEnabled="{Binding CanRemoveRestore}" Padding="10,6" ToolTip="選択した組の登録を外します。ファイルは削除しません。"/>
            </StackPanel>
            <DataGrid x:Name="RestoreFoldersGrid" ItemsSource="{Binding SelectedProfile.RestoreFolders}" SelectedItem="{Binding SelectedRestoreEntry}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="True" ColumnHeaderStyle="{StaticResource FolderColumnHeader}" MinColumnWidth="200" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="44" Height="264" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="復元フォルダーの対応一覧">
              <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
                </Style>
              </DataGrid.CellStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="復元元フォルダー" Width="*">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel Margin="6,4">
                    <Button DockPanel.Dock="Right" Content="参照…" Click="BrowseRestoreSource_Click" Padding="8,4" MinHeight="32" VerticalAlignment="Center" Margin="6,0,0,0" AutomationProperties.Name="復元元を参照"/>
                    <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" MinHeight="32" VerticalContentAlignment="Center" ToolTip="{Binding SourcePath}" AutomationProperties.Name="復元元フォルダー"/>
                  </DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="復元先フォルダー" Width="*">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel Margin="6,4">
                    <Button DockPanel.Dock="Right" Content="参照…" Click="BrowseRestoreDestination_Click" Padding="8,4" MinHeight="32" VerticalAlignment="Center" Margin="6,0,0,0" AutomationProperties.Name="復元先を参照"/>
                    <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" MinHeight="32" VerticalContentAlignment="Center" ToolTip="{Binding DestinationPath}" AutomationProperties.Name="復元先フォルダー"/>
                  </DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Thumb x:Name="RestoreFoldersResizeThumb" Style="{StaticResource FolderListResizeHandle}" AutomationProperties.Name="復元一覧の高さを変更" DragDelta="FolderListResize_DragDelta" PreviewKeyDown="FolderListResize_PreviewKeyDown" MouseDoubleClick="FolderListResize_MouseDoubleClick"/>
            <TextBlock Text="各行の復元元の中身を、同じ行の復元先へ順番に戻します。差分一覧の [番号] は行順です。" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="{Binding DestinationLabel}" VerticalAlignment="Center" Visibility="{Binding BackupSourcesVisibility}"/>
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActiveDestinationPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding DestinationFieldName}" Margin="0,0,8,0" ToolTip="{Binding DestinationTip}" Visibility="{Binding BackupSourcesVisibility}"/>
          <Button Grid.Row="2" Grid.Column="2" Content="参照…" Click="BrowseDestination_Click" Visibility="{Binding BackupSourcesVisibility}"/>
          <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#F0F9F7" CornerRadius="5" Padding="11,6" Margin="0,6,0,0"><TextBlock Text="{Binding OperationWarning}" FontSize="11" Foreground="#29645D"/></Border>
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,12,0,6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Grid.Column="1" Content="差分を確認" Click="Preview_Click" IsEnabled="{Binding CanRun}" Margin="8,0,8,0"/>
        <Button Grid.Column="2" Content="{Binding RunButtonText}" Click="Run_Click" IsEnabled="{Binding CanExecute}" Style="{StaticResource PrimaryButton}" ToolTip="{Binding RunTip}" ToolTipService.ShowOnDisabled="True"/>
        <Button Grid.Column="3" Content="中止" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" Margin="8,0,0,0"/>
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="4" Columns="4" Margin="0,8,0,0">
          <Border Background="White" CornerRadius="6" Padding="13,6" Margin="0,0,8,0"><StackPanel><TextBlock Text="追加" Style="{StaticResource Caption}"/><TextBlock Text="{Binding NewCount}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="White" CornerRadius="6" Padding="13,6" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding UpdateCountLabel}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding UpdatedCount}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="White" CornerRadius="6" Padding="13,6" Margin="0,0,8,0"><StackPanel><TextBlock Text="変更なし" Style="{StaticResource Caption}"/><TextBlock Text="{Binding UnchangedCount}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="White" CornerRadius="6" Padding="13,6"><StackPanel><TextBlock Text="コピー容量" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalSize}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        </UniformGrid>
      </Grid>
      <Border x:Name="PreviewPanel" Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="130">
        <TabControl Background="White" BorderThickness="0">
          <TabItem Header="  差分一覧  ">
            <Grid Margin="0,9,0,0">
              <DataGrid ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" RowHeaderWidth="0" Background="White" RowBackground="White" AlternatingRowBackground="#FCFDFE" EnableRowVirtualization="True" SelectionMode="Single" AutomationProperties.Name="差分一覧">
                <DataGrid.Columns><DataGridTextColumn Header="区分" Binding="{Binding Status}" Width="85"/><DataGridTextColumn Header="ファイル / フォルダー" Binding="{Binding RelativePath}" Width="*"/><DataGridTextColumn Header="サイズ" Binding="{Binding Size}" Width="100"/></DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{Binding EmptyMessage}" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="15"/>
            </Grid>
          </TabItem>
          <TabItem Header="  実行ログ  "><TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="White" FontFamily="Consolas, Meiryo" FontSize="11" Margin="0,8,0,0" TextChanged="LogBox_TextChanged"/></TabItem>
        </TabControl>
      </Border>
      <StackPanel Grid.Row="4" Margin="0,10,0,0">
        <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsScanning}" Foreground="#0F766E" Background="#DDE8E8" BorderThickness="0"/>
        <TextBlock Text="{Binding StatusText}" Margin="0,7,0,0" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DetailText}"/>
        <DockPanel Margin="0,4,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="ログを開く" Click="OpenLog_Click" IsEnabled="{Binding HasLog}" Padding="9,5" FontSize="11" Margin="0,0,8,0"/><Button Content="{Binding OpenDestinationText}" Click="OpenDestination_Click" IsEnabled="{Binding CanEdit}" Padding="9,5" FontSize="11"/></StackPanel>
          <TextBlock Text="{Binding SaveStatus}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
